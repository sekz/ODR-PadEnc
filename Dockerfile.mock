# Dockerfile.mock - Mock PadEnc for infrastructure testing
# Base: Official OpenDigitalRadio encoders image
# Mode: Mock (simulated behavior without real PAD processing)

FROM opendigitalradio/encoders:latest

LABEL version="1.0.0-mock"
LABEL component="pad-encoder"
LABEL mode="mock"
LABEL description="Mock ODR-PadEnc for StreamDAB multi-instance testing"

# Install Python and dependencies for health server
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && pip3 install --no-cache-dir aiohttp==3.9.1 \
    && rm -rf /var/lib/apt/lists/*

# Create user and directories
RUN groupadd -g 999 streamdab && \
    useradd -r -u 999 -g streamdab streamdab && \
    mkdir -p /var/log/odr /tmp/fifo /app /data/pad && \
    chown -R streamdab:streamdab /var/log/odr /tmp/fifo /app /data/pad

# Copy mock binary (replaces real odr-padenc)
COPY --chown=streamdab:streamdab mock-odr-padenc.sh /usr/bin/odr-padenc
COPY --chown=streamdab:streamdab entrypoint-multi-with-health.sh /app/
COPY --chown=streamdab:streamdab health_server.py /app/

# Make scripts executable
RUN chmod +x /usr/bin/odr-padenc /app/*.sh /app/*.py

# Environment variables
ENV INSTANCE_COUNT=3 \
    API_PORT_BASE=8110 \
    PORT_BASE=8020 \
    LOG_LEVEL=info \
    PAD_DIR=/data/pad

# Expose ports
# Health/API: 8110-8115 (per PORT-ALLOCATION-PLAN.md)
# TCP Output: 8020-8022
EXPOSE 8110-8115 8020-8022

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8110/health').read()" || exit 1

USER streamdab
WORKDIR /app

ENTRYPOINT ["/app/entrypoint-multi-with-health.sh"]
