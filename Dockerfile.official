# StreamDAB ODR-PadEnc Multi-Instance - Based on Official ODR Image
# Uses opendigitalradio/encoders as base with multi-instance wrapper

FROM opendigitalradio/encoders:latest

# Install additional dependencies for multi-instance management
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    netcat-openbsd \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for health endpoints
RUN pip3 install aiohttp

# Create streamdab user (matching our infrastructure)
RUN groupadd -r streamdab -g 999 && \
    useradd -r -g streamdab -u 999 streamdab || true

# Create required directories
RUN mkdir -p \
    /app/data \
    /app/logs \
    /app/data/slides \
    /var/log/odr \
    /tmp/fifo \
    && chown -R streamdab:streamdab /app /var/log/odr \
    && chmod 1777 /tmp/fifo

# Copy multi-instance entrypoint scripts
COPY entrypoint-multi.sh /app/
COPY entrypoint-multi-with-health.sh /app/
RUN chmod +x /app/entrypoint-multi*.sh && \
    chown streamdab:streamdab /app/entrypoint-multi*.sh

# Update binary paths in entrypoint to use /usr/bin/odr-padenc
RUN sed -i 's|/app/src/odr-padenc|/usr/bin/odr-padenc|g' /app/entrypoint-multi-with-health.sh && \
    sed -i 's|/app/build/bin/odr-padenc|/usr/bin/odr-padenc|g' /app/entrypoint-multi-with-health.sh

WORKDIR /app

# Expose API ports for 3 instances (8110-8112 for dev)
EXPOSE 8110 8111 8112
# Expose TCP ports for PAD output (8020-8022)
EXPOSE 8020 8021 8022

# Health check - verify at least one instance is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8110/health || curl -f http://localhost:8111/health || curl -f http://localhost:8112/health || exit 1

# Default environment variables
ENV INSTANCE_COUNT=3 \
    FIFO_BASE_PATH=/tmp/fifo \
    PORT_BASE=8020 \
    API_PORT_BASE=8110 \
    STREAMDAB_COMPONENT=padenc-multi \
    PAD_DIR=/app/data/slides \
    DLS_FILE=/app/data/dls.txt

USER streamdab

# Use multi-instance entrypoint with health endpoints
ENTRYPOINT ["/app/entrypoint-multi-with-health.sh"]
